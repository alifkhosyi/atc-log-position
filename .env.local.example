# ============================================================
# .env.local.example
#
# Copy ke .env.local (gitignored via *.local pattern) dan isi values:
#   cp .env.local.example .env.local
#
# Frontend (Vite — dipakai oleh src/supabase.js):
#   - Public, OK ke-bundle ke browser
#   - VITE_* prefix wajib agar Vite expose
# Bootstrap script (server-side, scripts/bootstrap-rosters.ts):
#   - SUPABASE_SERVICE_ROLE_KEY adalah CREDENTIAL SENSITIF
#   - JANGAN commit, JANGAN share, JANGAN expose ke frontend
#   - Ambil dari Supabase Dashboard → Settings → API → service_role key
# ============================================================

# ─── Frontend (Vite, public) ───
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key

# ─── Server-side scripts (NEVER commit) ───
# Bootstrap rosters script + future admin scripts pakai service role
# untuk bypass RLS dan insert lintas-cabang.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key

# ============================================================
# Usage example:
#   npm run bootstrap:rosters:dry     # dry-run, no DB write
#   npm run bootstrap:rosters         # live, seed all cabang
#
# Or direct:
#   npx tsx --env-file=.env.local scripts/bootstrap-rosters.ts
#   npx tsx --env-file=.env.local scripts/bootstrap-rosters.ts --only=WAEE
# ============================================================
